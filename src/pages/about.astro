---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = (import.meta.env.BASE_URL as string).replace(/\/?$/, '/');

const categories = [
  { emoji: '🩸', name: 'Complete Blood Count (CBC)' },
  { emoji: '⚗️', name: 'Basic Metabolic Panel (BMP)' },
  { emoji: '🫀', name: 'Liver Function Tests (LFTs)' },
  { emoji: '🧪', name: 'Coagulation Studies' },
  { emoji: '💨', name: 'Arterial Blood Gas (ABG)' },
  { emoji: '🦋', name: 'Thyroid Function Tests' },
  { emoji: '❤️', name: 'Lipid Panel' },
  { emoji: '💓', name: 'Cardiac Markers' },
  { emoji: '🔬', name: 'Urinalysis (UA)' },
  { emoji: '⚡', name: 'Electrolytes & Minerals' },
  { emoji: '🫘', name: 'Renal Function Tests' },
  { emoji: '🍬', name: 'Glucose & Diabetes Tests' },
];
---

<BaseLayout title="About" description="About the Nursing Lab Reference project.">
  <div class="page-header">
    <a href={base} class="back-link">← Home</a>
    <h1>About This Resource</h1>
  </div>

  <div class="content">
    <section class="card">
      <h2>🎯 Purpose</h2>
      <p>
        <strong>Nursing Lab Reference</strong> is an open-source study aid built with
        <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro.build</a>
        and hosted on <strong>GitHub Pages</strong>. It provides nursing students and educators with a
        clean, fast, and organized reference for commonly ordered laboratory tests.
      </p>
    </section>

    <section class="card">
      <h2>📋 Covered Categories</h2>
      <ul class="category-list">
        {categories.map((c) => (
          <li>{c.emoji} {c.name}</li>
        ))}
      </ul>
    </section>

    <section class="card">
      <h2>🔍 How to Use</h2>
      <ol>
        <li>Browse by <a href={`${base}categories`}>category</a> or start from the <a href={base}>home page</a>.</li>
        <li>Each category lists lab values with <strong>normal ranges</strong>, <strong>units</strong>, and <strong>critical values</strong>.</li>
        <li>Critical low values are highlighted in <span class="hl danger">red</span>; critical high values in <span class="hl warning">amber</span>.</li>
        <li>Clinical notes offer quick context for clinical decision-making.</li>
      </ol>
    </section>

    <section class="card warning-card">
      <h2>⚠️ Disclaimer</h2>
      <p>
        Reference ranges in this resource are based on widely accepted standard values and are intended
        for <strong>educational purposes only</strong>. Actual laboratory reference ranges vary by:
      </p>
      <ul>
        <li>Patient age, sex, and physiological state</li>
        <li>Laboratory equipment and methodology</li>
        <li>Institution-specific calibration</li>
      </ul>
      <p>
        <strong>Always use your institution's laboratory reference ranges in clinical practice.</strong>
        This resource should not be used as a substitute for clinical judgment or current evidence-based guidelines.
      </p>
    </section>

    <section class="card">
      <h2>🛠️ Built With</h2>
      <ul>
        <li><a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro.build</a> — Static site framework</li>
        <li><strong>TypeScript</strong> — Type-safe data definitions</li>
        <li><strong>GitHub Pages</strong> — Free static hosting</li>
        <li><strong>GitHub Actions</strong> — Automated deployment pipeline</li>
      </ul>
    </section>

    <section class="card">
      <h2>📝 Contributing</h2>
      <p>
        Corrections, additions, and improvements are welcome! Please open an issue or pull request on
        <a href="https://github.com/sagreenxyz/lab-reference" target="_blank" rel="noopener noreferrer">GitHub</a>.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .page-header { margin-bottom: 1.75rem; }
  .back-link { font-size: 0.875rem; color: var(--color-text-muted); display: inline-block; margin-bottom: 0.5rem; }
  .page-header h1 { font-size: 1.75rem; font-weight: 800; color: var(--color-primary-dark); }

  .content { max-width: 720px; display: flex; flex-direction: column; gap: 1.25rem; }

  .card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
  }

  .card h2 { font-size: 1.15rem; font-weight: 700; color: var(--color-primary-dark); margin-bottom: 0.75rem; }
  .card p { font-size: 0.95rem; line-height: 1.7; margin-bottom: 0.75rem; }
  .card p:last-child { margin-bottom: 0; }
  .card ul, .card ol { padding-left: 1.5rem; font-size: 0.95rem; line-height: 1.8; }
  .card li { margin-bottom: 0.2rem; }

  .warning-card {
    border-left: 4px solid var(--color-warning);
    background: var(--color-warning-light);
  }

  .category-list { list-style: none; padding: 0; columns: 2; }
  .category-list li { padding: 0.15rem 0; }

  .hl {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.1rem 0.5rem;
    border-radius: 4px;
  }
  .hl.danger { background: var(--color-danger-light); color: var(--color-danger); }
  .hl.warning { background: var(--color-warning-light); color: #92400e; }

  @media (max-width: 500px) {
    .category-list { columns: 1; }
  }
</style>
