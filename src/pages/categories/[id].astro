---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { labCategories, type LabValue } from '../../content/labValues';

export function getStaticPaths() {
  return labCategories.map((cat) => ({
    params: { id: cat.id },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const base = (import.meta.env.BASE_URL as string).replace(/\/?$/, '/');

function hasCritical(value: LabValue): boolean {
  return Boolean(value.criticalLow || value.criticalHigh);
}
---

<BaseLayout
  title={category.title}
  description={`Normal ranges and critical values for ${category.title} — nursing lab reference.`}
>
  <div class="page-header">
    <a href={`${base}categories`} class="back-link">← All Categories</a>
    <div class="title-row">
      <span class="cat-icon">{category.icon}</span>
      <div>
        <h1>{category.title}</h1>
        <p class="desc">{category.description}</p>
      </div>
    </div>
  </div>

  <!-- Legend -->
  <div class="legend">
    <span class="badge badge-critical">⚠ Critical value available</span>
    <span class="legend-note">Hover or tap any row for more details.</span>
  </div>

  <!-- Lab Values Table -->
  <div class="table-wrapper">
    <table class="lab-table">
      <thead>
        <tr>
          <th>Lab Value</th>
          <th>Normal Range</th>
          <th>Unit</th>
          <th>Critical Low</th>
          <th>Critical High</th>
          <th>Clinical Notes</th>
        </tr>
      </thead>
      <tbody>
        {category.values.map((val) => (
          <tr class={hasCritical(val) ? 'has-critical' : ''}>
            <td class="val-name">
              <span class="name">{val.name}</span>
              {val.abbreviation && <span class="abbr">{val.abbreviation}</span>}
            </td>
            <td class="normal">{val.normalRange}</td>
            <td class="unit">{val.unit || '—'}</td>
            <td class="critical-low">
              {val.criticalLow
                ? <span class="critical-badge danger">{val.criticalLow}</span>
                : <span class="na">—</span>
              }
            </td>
            <td class="critical-high">
              {val.criticalHigh
                ? <span class="critical-badge warning">{val.criticalHigh}</span>
                : <span class="na">—</span>
              }
            </td>
            <td class="notes">{val.notes || '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <!-- Card view for mobile -->
  <div class="card-list" aria-hidden="true">
    {category.values.map((val) => (
      <div class="val-card">
        <div class="val-card-header">
          <span class="name">{val.name}</span>
          {val.abbreviation && <span class="abbr">{val.abbreviation}</span>}
        </div>
        <dl class="val-card-body">
          <div class="dl-row">
            <dt>Normal Range</dt>
            <dd class="normal">{val.normalRange} {val.unit && <em>{val.unit}</em>}</dd>
          </div>
          {val.criticalLow && (
            <div class="dl-row">
              <dt>Critical Low</dt>
              <dd><span class="critical-badge danger">{val.criticalLow}</span></dd>
            </div>
          )}
          {val.criticalHigh && (
            <div class="dl-row">
              <dt>Critical High</dt>
              <dd><span class="critical-badge warning">{val.criticalHigh}</span></dd>
            </div>
          )}
          {val.notes && (
            <div class="dl-row full">
              <dt>Notes</dt>
              <dd>{val.notes}</dd>
            </div>
          )}
        </dl>
      </div>
    ))}
  </div>

  <div class="disclaimer-small">
    ⚠️ Values are approximate and may vary by laboratory and patient population. Always consult institutional reference ranges.
  </div>
</BaseLayout>

<style>
  /* Page header */
  .page-header { margin-bottom: 1.5rem; }
  .back-link {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    display: inline-block;
    margin-bottom: 0.75rem;
  }
  .title-row {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }
  .cat-icon { font-size: 2.5rem; line-height: 1; flex-shrink: 0; }
  .title-row h1 {
    font-size: clamp(1.3rem, 3vw, 1.75rem);
    font-weight: 800;
    color: var(--color-primary-dark);
    margin-bottom: 0.25rem;
  }
  .desc { color: var(--color-text-muted); font-size: 0.9rem; line-height: 1.5; }

  /* Legend */
  .legend {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .legend-note { font-size: 0.8rem; color: var(--color-text-muted); }
  .badge { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.78rem; font-weight: 600; padding: 0.2rem 0.6rem; border-radius: 9999px; }
  .badge-critical { background: var(--color-danger-light); color: var(--color-danger); }

  /* Table */
  .table-wrapper {
    overflow-x: auto;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    margin-bottom: 1.5rem;
  }

  .lab-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    background: var(--color-surface);
  }

  .lab-table th {
    background: var(--color-primary);
    color: #fff;
    padding: 0.75rem 1rem;
    text-align: left;
    font-weight: 600;
    white-space: nowrap;
  }

  .lab-table td {
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
  }

  .lab-table tbody tr:last-child td { border-bottom: none; }

  .lab-table tbody tr:hover { background: var(--color-primary-light); }

  .lab-table tbody tr.has-critical { border-left: 3px solid var(--color-danger); }

  .val-name .name { font-weight: 600; display: block; }
  .abbr {
    display: inline-block;
    background: var(--color-primary-light);
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.1rem 0.5rem;
    border-radius: 4px;
    margin-top: 0.2rem;
    font-family: var(--font-mono);
  }

  .normal { font-weight: 600; color: var(--color-accent); white-space: nowrap; }
  .unit { color: var(--color-text-muted); font-size: 0.82rem; white-space: nowrap; }
  .notes { color: var(--color-text-muted); font-size: 0.83rem; line-height: 1.4; max-width: 360px; }
  .na { color: var(--color-border); }

  .critical-badge {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    white-space: nowrap;
    font-family: var(--font-mono);
  }
  .critical-badge.danger { background: var(--color-danger-light); color: var(--color-danger); }
  .critical-badge.warning { background: var(--color-warning-light); color: #92400e; }

  /* Card list (mobile only) */
  .card-list { display: none; }

  /* Disclaimer */
  .disclaimer-small {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    background: var(--color-warning-light);
    border: 1px solid var(--color-warning);
    padding: 0.75rem 1rem;
    border-radius: var(--radius);
  }

  /* Mobile — swap to cards */
  @media (max-width: 700px) {
    .table-wrapper { display: none; }
    .card-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    .val-card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
    }

    .val-card-header {
      background: var(--color-primary-light);
      padding: 0.75rem 1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    .val-card-header .name { font-weight: 700; color: var(--color-primary-dark); }

    .val-card-body { padding: 0.75rem 1rem; }

    .dl-row {
      display: flex;
      gap: 0.5rem;
      margin-bottom: 0.4rem;
      font-size: 0.88rem;
    }
    .dl-row.full { flex-direction: column; }
    .dl-row dt { font-weight: 600; color: var(--color-text-muted); min-width: 100px; }
    .dl-row dd { flex: 1; }
  }
</style>
