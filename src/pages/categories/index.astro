---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { labCategories } from '../../content/labValues';

const base = (import.meta.env.BASE_URL as string).replace(/\/?$/, '/');
---

<BaseLayout title="All Categories" description="Browse all nursing lab value categories.">
  <div class="page-header">
    <a href={base} class="back-link">← Home</a>
    <h1>All Lab Categories</h1>
    <p>Choose a category to view normal ranges, critical values, and nursing notes.</p>
  </div>

  <div class="category-list">
    {labCategories.map((cat) => (
      <a href={`${base}categories/${cat.id}`} class="category-row">
        <span class="cat-icon">{cat.icon}</span>
        <div class="cat-info">
          <h2 class="cat-title">{cat.title}</h2>
          <p class="cat-desc">{cat.description}</p>
        </div>
        <span class="cat-count">{cat.values.length} values →</span>
      </a>
    ))}
  </div>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 2rem;
  }
  .back-link {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    display: inline-block;
    margin-bottom: 0.5rem;
  }
  .page-header h1 {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-primary-dark);
    margin-bottom: 0.25rem;
  }
  .page-header p { color: var(--color-text-muted); }

  .category-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .category-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.1rem 1.5rem;
    box-shadow: var(--shadow-sm);
    color: var(--color-text);
    transition: box-shadow .2s, border-color .2s, transform .2s;
  }
  .category-row:hover {
    box-shadow: var(--shadow);
    border-color: var(--color-primary);
    transform: translateX(4px);
    text-decoration: none;
  }

  .cat-icon { font-size: 1.75rem; flex-shrink: 0; }

  .cat-info { flex: 1; }

  .cat-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    margin-bottom: 0.2rem;
  }

  .cat-desc {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .cat-count {
    white-space: nowrap;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary);
    flex-shrink: 0;
  }
</style>
